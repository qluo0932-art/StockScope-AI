# Required. Create a key at https://finnhub.io/
FINNHUB_API_KEY=

# Required. Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. The default follows the current OpenAI model recommendation.
OPENAI_MODEL=gpt-5.5

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
